{
  "name": "mpasat-attendance-desktop",
  "version": "2.1.0",
  "private": true,
  "description": "MPASAT Attendance desktop app",
  "author": "Izzy Tech Team",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "npm --prefix ../web-front run build:desktop && electron-builder --win nsis",
    "build:ui": "npm --prefix ../web-front run build:desktop",
    "payload": "node scripts/build-payload.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mpasat.attendance.desktop",
    "productName": "MPASAT Attendance",
    "copyright": "Copyright © Izzy Tech Team",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "software-manifest.json",
      "package.json",
      {
        "from": "../mobile-back",
        "to": "mobile-back",
        "filter": [
          "**/*.js",
          "!scripts/**",
          "!**/.env",
          "!node_modules/**"
        ]
      },
      {
        "from": "../web-front/dist",
        "to": "ui"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MPASAT Attendance",
      "uninstallDisplayName": "MPASAT Attendance",
      "runAfterFinish": true,
      "artifactName": "MPASAT-Attendance-Setup-${version}.exe"
    }
  }
}
