# Attendance + web API — copy to .env on the server

PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Auth (required in production)
JWT_SECRET=change-me-long-random-string

# Web admin login (landing site admin panel)
WEB_ADMIN_USERNAME=vti-admin!
WEB_ADMIN_PASSWORD=change-me

# CORS — frontend URLs that may call this API (comma-separated)
WEB_CORS_ORIGINS=https://www.vtispace.com,https://vtispace.com,http://localhost:5173

# Storage (FTP) — required; all images/files are uploaded here (nothing saved locally)
FTP_HOST=st69310.ispot.cc
FTP_USER=vtispace@st69310.ispot.cc
FTP_PASS=change-me
FTP_SECURE=false
FTP_PORT=21
# Must be the web-accessible folder (usually /public_html on ispot/DirectAdmin)
FTP_BASE_DIR=/public_html
FTP_PUBLIC_BASE_URL=https://st69310.ispot.cc
# Optional: FTP_BASE_URL (alias), FTP_PASSWORD (alias for FTP_PASS)

# Guardian SMS via SMSVAS (enable Send SMS in admin Settings)
SMS_DEFAULT_COUNTRY_CODE=237
SMS_API_BASE_URL=https://smsvas.com/bulk/public/index.php/api/v1
SMS_API_USER=your-smsvas-username
SMS_API_PASSWORD=your-smsvas-password
SMS_SENDER_ID=waymakerSL
# Optional DLR webhook token: POST /api/attendance/sms/dlr?token=...
# SMS_DLR_TOKEN=
# SMS_ENABLED=false

# Optional
# WEB_SESSION_HOURS=12
# ATTENDANCE_SESSION_HOURS=12
# PRIVACY_CONTACT_EMAIL=support@vtispace.com

